datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  brandName    String
  slug         String   @unique
  tagline      String?
  category     String   @default("QSR")
  address      String
  phone        String
  email        String
  gstin        String
  fssai        String
  currency     String   @default("INR")
  currencySymbol String @default("₹")
  planTier     String   @default("growth")
  status       String   @default("active")
  themeColor   String   @default("#111827")
  logoUrl      String?
  featuresJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  addOnGroups  AddOnGroup[]
  orders       Order[]
  settings     SystemSettings?
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  role           String   // 'cashier' | 'kitchen' | 'manager' | 'owner' | 'admin'
  pinHash        String   // bcrypt hash of 4-digit PIN
  passwordHash   String?  // bcrypt hash for email logins (managers/owners/admins)
  avatarInitials String   @default("U")
  title          String   @default("Staff")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
  shifts         Shift[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model SystemSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeName           String
  brandTagline        String   @default("")
  gstin               String   @default("")
  fssai               String   @default("")
  gstRate             Float    @default(5.0)
  isTaxInclusive      Boolean  @default(false)
  receiptHeader       String   @default("Welcome to Sign Laban!")
  receiptFooter       String   @default("Thank you! Follow us on Instagram")
  wifiPassword        String   @default("")
  showWifiOnReceipt   Boolean  @default(true)
  autoPrintReceipt    Boolean  @default(true)
  cashTiming          String   @default("before") // 'before' | 'after'
  kdsTargetMinutes    Int      @default(8)
  soundAlertsEnabled  Boolean  @default(true)
  orderPrefix         String   @default("#")
  nextOrderSequence   Int      @default(300)
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int      @default(0)

  products  Product[]

  @@unique([tenantId, slug])
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String   @default("")
  price           Float
  image           String   @default("")
  station         String   @default("Cold") // 'Grill' | 'Fry' | 'Cold' | 'Expo'
  isAvailable     Boolean  @default(true)
  isPopular       Boolean  @default(false)
  addOnGroupIdsJson String @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
}

model AddOnGroup {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int         @default(0)
  maxSelect Int         @default(3)

  items     AddOnItem[]
}

model AddOnItem {
  id          String     @id @default(cuid())
  groupId     String
  group       AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  isAvailable Boolean    @default(true)
  isDefault   Boolean    @default(false)
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber     String      // e.g. #332
  type            String      @default("takeaway") // 'dine-in' | 'takeaway'
  customerName    String      @default("Walk-in Guest")
  guestCount      Int         @default(1)
  tableNumber     String?
  subtotal        Float
  discount        Float       @default(0.0)
  discountPercent Float       @default(0.0)
  cgst            Float       @default(0.0)
  sgst            Float       @default(0.0)
  tax             Float       @default(0.0)
  total           Float
  paymentMode     String      @default("cash") // 'cash' | 'card' | 'upi'
  paymentStatus   String      @default("paid") // 'paid' | 'pending' | 'refunded'
  cashTendered    Float?
  cashChange      Float?
  upiRef          String?
  cashierId       String
  cashierName     String
  cashier         User        @relation(fields: [cashierId], references: [id])
  status          String      @default("preparing") // 'preparing' | 'ready' | 'completed' | 'cancelled'
  notes           String?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?

  items           OrderItem[]
  kdsTickets      KdsTicket[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  name                String
  quantity            Int      @default(1)
  unitPrice           Float
  lineTotal           Float
  specialInstructions String?
  selectedAddOnsJson  String   @default("[]")
}

model KdsTicket {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber      String
  orderType        String
  customerName     String
  guestCount       Int             @default(1)
  tableNumber      String?
  channel          String          @default("POS")
  courierInfo      String?
  targetMinutes    Int             @default(8)
  createdAt        DateTime        @default(now())
  cookingStartedAt DateTime?
  readyAt          DateTime?
  bumpedAt         DateTime?
  status           String          @default("new") // 'new' | 'cooking' | 'ready' | 'bumped'
  isRush           Boolean         @default(false)
  allergyNote      String?
  prepNote         String?

  items            KdsTicketItem[]

  @@index([status])
}

model KdsTicketItem {
  id            String    @id @default(cuid())
  ticketId      String
  ticket        KdsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId     String
  name          String
  quantity      Int       @default(1)
  station       String    @default("Cold")
  modifiersJson String    @default("[]")
  isReady       Boolean   @default(false)
}

model Shift {
  id                     String         @id @default(cuid())
  tenantId               String
  shiftNumber            Int
  date                   String
  cashierId              String
  cashierName            String
  cashier                User           @relation(fields: [cashierId], references: [id])
  startTime              DateTime       @default(now())
  endTime                DateTime?
  status                 String         @default("open") // 'open' | 'closed'
  openingCash            Float          @default(0.0)
  countedCash            Float?
  expectedCash           Float?
  variance               Float?
  totalOrders            Int            @default(0)
  cashSales              Float          @default(0.0)
  cardSales              Float          @default(0.0)
  upiSales               Float          @default(0.0)
  grossSales             Float          @default(0.0)
  totalDiscount          Float          @default(0.0)
  totalTax               Float          @default(0.0)
  refunds                Float          @default(0.0)
  denominationCountsJson String         @default("{}")

  movements              CashMovement[]
}

model CashMovement {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      String   // 'in' | 'out'
  amount    Float
  reason    String
  timestamp DateTime @default(now())
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  tenantId    String
  type        String    // 'refund' | 'void' | 'discount'
  orderId     String
  orderNumber String
  amount      Float
  reason      String
  requestedBy String
  requestedAt DateTime  @default(now())
  status      String    @default("pending") // 'pending' | 'approved' | 'rejected'
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // 'login' | 'no_sale_drawer_open' | 'price_override' | 'discount_high' | 'order_void' | 'pin_reset' | 'stock_86' | 'supervisor_override'
  description String
  staffName   String
  timestamp   DateTime @default(now())
  metadataJson String  @default("{}")
}

